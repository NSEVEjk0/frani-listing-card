# Frani Listing Card — configuration
# Copy to .env and adjust. All values default to testnet2.

# Network. Must be testnet2. Do not point this at mainnet.
LISTING_NETWORK=testnet2

# Where the wallet keys and state live on disk.
LISTING_DATA_DIR=./wallet-data

# testnet2 wallet-api base URL.
LISTING_WALLET_API=https://wallet-api.unicity.network

# Public testnet2 oracle key (not a secret).
LISTING_ORACLE_KEY=sk_ddc3cfcc001e4a28ac3fad7407f99590

# Stable per-machine device id for the wallet-api session.
LISTING_DEVICE_ID=frani-listing-1

# Optional @nametag to register on first run (leave blank to skip).
LISTING_NAMETAG=

# Where listing cards are stored.
LISTING_DIR=./listings

# Market API base URL. Leave blank for the SDK default
# (https://market-api.unicity.network). The market bulletin board is optional:
# cards work as signed, shareable objects even when it is unreachable.
LISTING_MARKET_API=
LISTING_MARKET_TIMEOUT_MS=12000

# Optional paid "introduction" fee in whole UCT. 0 disables it.
LISTING_INTRO_FEE_UCT=0
